        <field name="domain">[('client', '=', True)]</field>
        <field name="context">{'default_client': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Client Environment
            </p>
            <p></p>
        </field>
    </record>
