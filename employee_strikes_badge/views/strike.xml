<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Strike views -->
    <record id="gamification_badge_view_search" model="ir.ui.view">
        <field name="name">employee.strike.search</field>
        <field name="model">employee.strike</field>
        <field name="arch" type="xml">
            <search string="Search Strike">
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <!---->
            </search>
        </field>
    </record>

    <record id="strike_list_action" model="ir.actions.act_window">
        <field name="name">Strikes</field>
        <field name="res_model">employee.strike</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="gamification_badge_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Strike
            </p>
        </field>
    </record>

    <record id="strike_user_action" model="ir.actions.act_window">
        <field name="name">User Strikes</field>
        <field name="res_model">employee.strike.user</field>
        <field name="view_mode">kanban</field>
        <!-- <field name="context">{'search_default_inprogress':True, 'default_inprogress':True}</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new challenge
            </p>
        </field>
    </record>


    <record id="strike_list_view" model="ir.ui.view">
        <field name="name">Strike List</field>
        <field name="model">employee.strike</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="granted_count"/>
                <field name="stat_this_month"/>
                <!--<field name="stat_my"/>-->
                <field name="rule_strike"/>
            </list>
        </field>
    </record>

    <record id="strike_form_view" model="ir.ui.view">
        <field name="name">Badge Form</field>
        <field name="model">employee.strike</field>
        <field name="arch" type="xml">
            <form string="Strike">
                <header>
                    <button string="Issue this Strike" type="action" name="%(action_issue_wizard)d" class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="get_granted_employees"
                                invisible='granted_count == 0' icon="fa-user">
                            <field name="granted_employees_count" string="Issued" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible='active == True'/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Strike Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description" nolabel="1" colspan="2" placeholder="Strike Description"/>
                    </group>
                    <group string="Issuance">
                        <div class="oe_grey" colspan="2">
                            Security rules to define who is allowed to manually grant strikes.
                        </div>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="rule_strike" />
                            <field name="rule_auth_user_ids" invisible='rule_strike != "users"'
                                   widget="many2many_tags"/>
                            <!--<field name="rule_auth_badge_ids" attrs="{'invisible': [('rule_strike','!=','having')]}"-->
                                   <!--widget="many2many_tags"/>-->
                            <!--<field name="rule_max" attrs="{'invisible': [('rule_strike','=','nobody')]}"/>-->
                            <!--<field name="rule_max_number"-->
                            <!--attrs="{'invisible': ['|',('rule_max','=',False),('rule_strike','=','nobody')]}"/>-->
                            <!--<label for="stat_my_monthly_sending"/>-->
                            <!--<div>-->
                            <!--<field name="stat_my_monthly_sending"-->
                            <!--attrs="{'invisible': [('rule_strike','=','nobody')]}"/>-->
                            <!--<div attrs="{'invisible': [('remaining_sending','=',-1)]}" class="oe_grey">-->
                            <!--You can still grant-->
                            <!--<field name="remaining_sending" class="oe_inline"/>-->
                            <!--badges this month-->
                            <!--</div>-->
                            <!--<div attrs="{'invisible': [('remaining_sending','!=',-1)]}" class="oe_grey">-->
                            <!--No monthly sending limit-->
                            <!--</div>-->
                            <!--</div>-->
                            <field name="penalty"/>
                        </group>
                    </group>
                    <!--<group string="Rewards for challenges">-->
                    <!--<field name="challenge_ids" mode="kanban" widget="many2many" nolabel="1"-->
                    <!--context="{'default_reward_id': active_id}"/>-->
                    <!--<field name="level"/>-->
                    <!--</group>-->
                    <group id="badge_statistics" string="Statistics">
                        <group>
                            <field name="granted_count"/>
                            <field name="stat_this_month"/>
                            <field name="granted_users_count"/>
                        </group>
                        <!--<group>-->
                            <!--<field name="stat_my"/>-->
                            <!--<field name="stat_my_this_month"/>-->
                        <!--</group>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="strike_kanban_view" model="ir.ui.view">
        <field name="name">Strike Kanban View</field>
        <field name="model">employee.strike</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_badge">
                <field name="id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="stat_my"/>
                <field name="granted_count"/>
                <field name="stat_this_month"/>
                <field name="unique_owner_ids"/>
                <field name="stat_my_monthly_sending"/>
                <field name="remaining_sending"/>
                <field name="rule_max_number"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_kanban_gamification oe_kanban_global_click #{record.stat_my.raw_value ? 'oe_kanban_color_5' : 'oe_kanban_color_white'}">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('employee.strike', 'image_1024', record.id.raw_value)"
                                     t-att-title="record.name.value" t-att-alt="record.name.value"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="oe_grey">
                                    <t t-if="record.remaining_sending.value != -1">
                                        <t t-esc="record.stat_my_monthly_sending.value"/>/
                                        <t t-esc="record.rule_max_number.value"/>
                                    </t>
                                    <t t-if="record.remaining_sending.value == -1">
                                        <t t-esc="record.stat_my_monthly_sending.value"/>/∞
                                    </t>
                                </span>
                                <div t-if="record.remaining_sending.value == 0" class="oe_grey">Can not grant</div>
                                <div>
                                    <strong>
                                        <t t-esc="record.granted_count.raw_value"/>
                                    </strong>
                                    Issued,
                                    <strong>
                                        <t t-esc="record.stat_this_month.raw_value"/>
                                    </strong>
                                    this month
                                </div>
                                <div t-if="record.description.value" class="o_kanban_badge_description">
                                    <em>
                                        <field name="description"/>
                                    </em>
                                    <div>
                                        <t t-foreach="record.unique_owner_ids.raw_value.slice(0,11)" t-as="owner">
                                            <img class="oe_kanban_avatar o_image_24_cover"
                                                 t-att-src="kanban_image('res.users', 'image_128', owner)"
                                                 t-att-data-member_id="owner" alt="Owner"/>
                                        </t>
                                    </div>
                                </div>
                                <div t-if="record.remaining_sending.value != 0 and !selection_mode"
                                     class="o_kanban_button">
                                    <button type="action" name="%(action_issue_wizard)d"
                                            class="oe_highlight btn btn-primary">Issue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Badge user viewss -->

    <record id="strike_user_kanban_view" model="ir.ui.view">
        <field name="name">Strike User Kanban View</field>
        <field name="model">employee.strike.user</field>
        <field name="arch" type="xml">
            <kanban action="action_open_strike" type="object" class="oe_background_grey">
                <field name="strike_name"/>
                <field name="strike_id"/>
                <field name="user_id"/>
                <field name="comment"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click oe_kanban_badge oe_kanban_color_white o_kanban_gamification">
                            <div class="o_kanban_content">
                                <div class="o_kanban_image">
                                    <a type="open">
                                        <img t-att-src="kanban_image('employee.strike', 'image_1024', record.strike_id.raw_value)"
                                             t-att-title="record.strike_name.value"
                                             t-att-alt="record.strike_name.value"/>
                                    </a>
                                </div>
                                <div class="oe_kanban_details">
                                    <h4 class="mt0 mb0">
                                        <a class="o_kanban_record_title" type="open">
                                            <t t-esc="record.strike_name.raw_value"/>
                                        </a>
                                    </h4>
                                    <t t-if="record.comment.raw_value">
                                        <p class="o_kanban_record_subtitle">
                                            <em>
                                                <field name="comment"/>
                                            </em>
                                        </p>
                                    </t>
                                    <p>Issued by <a type="open"> <field name="create_uid"/></a> the <t t-esc="luxon.DateTime.fromISO(record.create_date.raw_value).toFormat('dd/MM/yyyy')"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="strike_user_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="employee_strikes_badge.strike_user_action"/>
        <field name="view_id" ref="employee_strikes_badge.strike_user_kanban_view"/>
    </record>

    <menuitem id="hr_gamification.gamification_badge_menu_hr" parent="hr_gamification.menu_hr_gamification"
              action="gamification.badge_list_action" sequence="1"/>
    <menuitem id="menu_hr_gamification" parent="hr_gamification.menu_hr_gamification" name="Strikes"
              action="strike_list_action" sequence="2"/>
</odoo>
