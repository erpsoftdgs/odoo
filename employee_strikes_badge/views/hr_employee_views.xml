<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hr_manager_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_gamification.hr_hr_employee_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='public']" position="after">
                <page string="Received Strikes" name="received_strikes"
                      invisible='not user_id'>
                    <field name="has_strikes" invisible="1"/>
                    <button string="Issue a Strike" type="action" name="%(action_reward_wizard)d"/>
                    <div class="o_field_nocontent" invisible='has_strikes'>
                        <p>
                            Issue a strike to penalise this employee for a wrong action
                        </p>
                    </div>
                    <div class="mt-2">
                        <field name="strike_ids" mode="kanban" />
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <record id="hr_employee_public_view_form" model="ir.ui.view">
        <field name="name">hr.employee.public.view.form.inherit</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr_gamification.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='public']" position="after">
                <page string="Received Strikes" name="received_strikes" invisible='not user_id'>
                    <field name="has_strikes" invisible="1"/>
                    <button string="Issue a Strike" type="action" name="%(action_reward_wizard)d"/> 
                    to penalise this employee for a wrong action
                    <div class="o_field_nocontent" invisible='has_strikes'>
                        <p>
                            Issue a strike to penalise this employee for a wrong action
                        </p>
                    </div>
                    <field name="strike_ids" mode="kanban" widget="many2many"/>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
