    <record id="view_crm_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
	<field name="arch" type="xml">
	    <xpath expr="//field[@name='partner_id']" position="after">
		<field name="score_percentage" readonly="1"/>		
	    </xpath>
            <xpath expr="//group[1]" position="after">
		<group>
                    <field name="contact_type"/>
                    <field name="business_size"/>
                    <field name="company_size"/>
                    <field name="number_employee"/>
                    <field name="modules_estimate"/>
                    <field name="industry_sector"/>
                    <field name="number_user"/>
                    <field name="customization"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_crm_lead_tree" model="ir.ui.view">
    <field name="name">crm.lead.tree.inherit</field>
    <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="score_percentage" readonly="1"/>
                <field name="activity_date_deadline"/>
                <field name="activity_summary"/>
            </xpath>
        </field>
    </record>
    <record id="crm_lead_score_update_cron" model="ir.cron">
        <field name="name">Lead generation:scoring</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model.update_lead_scores()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>

    <menuitem id="crm_menu_configuration" name="Configuration"/>

    <menuitem id="lead_qualification_menu"
              name="Lead Qualification"
              parent="crm.crm_menu_config"/>
    <menuitem id="contact_type_menu"
              name="Contact Type"
              action="contact_type_action"
              parent="lead_qualification_menu"
              sequence="1"/>

    <menuitem id="business_size_menu"
              name="Business Size"
              action="crm_scoring.business_size_action"
              parent="lead_qualification_menu"
              sequence="2"/>

