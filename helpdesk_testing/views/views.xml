        <record id="res_config_settings_view_form_inherit_my_module" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.my.module</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Target the Integrations block -->
                <xpath expr="//block[@name='integration']" position="inside">
                    <setting string="Selenium Regression Test">
                        <field name="selenium_regression_test"/>
                        <div class="content-group" invisible="selenium_regression_test == False" required="selenium_regression_test == True">
                            <label for="selenium_grid_server" class="o_light_label"/>
                            <field name="selenium_grid_server" widget="url"
                                    required="selenium_regression_test == True"/>
                            <label for="selenium_ide_runner_location" class="o_light_label"/>
                            <field name="selenium_ide_runner_location" widget="url"
                                    required="selenium_regression_test == True"/>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>

