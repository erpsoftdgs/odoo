<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Approvers -->
     <record id="iso_approvers_tree" model="ir.ui.view">
            <field name="name">iso.approver.view.tree</field>
            <field name="model">iso.approver</field>
            <field name="arch" type="xml">
                <list string="Approvers" editable="bottom" >
                    <field name="department" />
                    <field name="team_lead" />
                    <field name="project_manager" />
                    <field name="quality_manager" />
                    <field name="compliance_manager" />
                    <field name="auditor" />
                    <field name="executive_board" />
                </list>
            </field>
        </record>

          <record id="action_iso_approvers" model="ir.actions.act_window">
     <field name="name">ISO Approvers</field>
     <field name="type">ir.actions.act_window</field>
     <field name="res_model">iso.approver</field>
     <field name="view_mode">list</field>
     <field name="view_id" ref="iso_approvers_tree"/>
     <field name="domain">[]</field>
     <field name="context">{}</field>
     <field name="help" type="html">
       <p class="o_view_nocontent_smiling_face">
         Create a ISO Approvers
       </p><p>
       </p>
     </field>
 </record>
<!-- End Approvers -->
    <!-- Non Conformity Type -->

         <record id="iso_non_conformity_type_tree" model="ir.ui.view">
