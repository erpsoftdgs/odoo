<odoo>
    <!-- List View for Key Priority Task -->
    <record id="view_key_priority_task_tree" model="ir.ui.view">
        <field name="name">key.priority.task.list</field>
        <field name="model">key.priority.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name" />
                <field name="score" string="Score" />
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <!-- Form View for Key Priority Task -->
    <record id="view_key_priority_task_form" model="ir.ui.view">
        <field name="name">key.priority.task.form</field>
        <field name="model">key.priority.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Name" />
                        <field name="score" string="Score" />
                        <field name="color" widget="color_picker" string="Color" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action for Key Priority Task -->
    <record id="action_key_priority_task" model="ir.actions.act_window">
        <field name="name">Key Priority Task</field>
        <field name="res_model">key.priority.task</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_key_priority_task_tree" />
    </record>
</odoo>
