<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_badge_wizard_reward" model="ir.ui.view">
            <field name="name">employee.strike.user.wizard.form</field>
            <field name="model">employee.strike.user.wizard</field>
            <field name="arch" type="xml">
                <form string="Reward Employee with">
                    What penalty should be given?
                    <group>
                        <field name="employee_id" invisible="1" />
                        <field name="user_id" invisible="1" />
                        <field name="strike_id" nolabel="1" colspan="2" />
                        <field name="comment" nolabel="1" colspan="2" placeholder="Describe what they did and why it matters (will be public)" />
                    </group>
                    <footer>
                        <button string="Penalise Employee" type="object" name="action_grant_badge" class="btn-primary" />
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_reward_wizard" model="ir.actions.act_window">
            <field name="name">Penalise Employee</field>
            <field name="res_model">employee.strike.user.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_badge_wizard_reward"/>
            <field name="target">new</field>
            <field name="domain">[]</field>
            <field name="context">{'default_employee_id': active_id, 'employee_id': active_id}</field>
        </record>

    <record id="view_badge_wizard_grant" model="ir.ui.view">
        <field name="name">Issue Strike User Form</field>
        <field name="model">employee.strike.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Grant Badge To">
                Who would you like to penalise?
                <field name="strike_id" invisible="1"/>
                <group>
                    <field name="user_id" nolabel="1" invisible="1"/>
                     <field name="employee_id" nolabel="1" colspan="2" domain="[('user_id', '!=', False)]"/>
                    <field name="comment" nolabel="1" colspan="2" placeholder="Describe what they did and why it matters (will be public)" />
                </group>
                <footer>
                    <button string="Issue Strike" type="object" name="action_grant_badge" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    
    <record id="action_issue_wizard" model="ir.actions.act_window">
        <field name="name">Issue Strike</field>
        <field name="res_model">employee.strike.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_badge_wizard_grant"/>
        <field name="target">new</field>
        <field name="context">{
            'default_strike_id': active_id,
            'strike_id': active_id
        }</field>
    </record>

</odoo>