<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="csm_training_cancel_form" model="ir.ui.view">
        <field name="name">client.training.cancel.form</field>
        <field name="model">client.training.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancellation Reason">
                <group>
                    <field name="message" required="1" string="Please state why this training has been cancelled"/>
                </group>
                <footer>
                    <button name="cancel_training" string="Cancel Training" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


