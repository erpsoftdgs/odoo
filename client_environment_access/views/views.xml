<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Environment -->

    <record model="ir.ui.view" id="client_environment_access_form">
        <field name="name">Client Environment</field>
        <field name="model">client.environment.access</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="demo" invisible="1" />
                    <field name="erpsoftapp_env" invisible="1" />
                    <field name="erpsoftapp_prod" invisible="1" />
                    <field name="test_env" invisible="1" />
                    <group col='4' invisible="test_env or erpsoftapp_prod">
                        <!-- <group> -->
                        <field name="name" />
                        <!-- </group> -->
                        <!-- <group> -->
                        <field name="server" widget="url" />
                        <!-- </group> -->
                        <!-- <group> -->
                        <field name="server_id" invisible="erpsoftapp_env" />
                        <!-- </group> -->
                        <!-- <group> -->
                        <field name="odoo_version" />
                        <!-- </group> -->
                    </group>
                    <!-- Production Env -->
                    <group col='2' invisible="not erpsoftapp_prod">
                        <group>
                            <field name="server" widget="url" string="Server" />
                            <field name="odoo_version" />
                            <field name="username" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                            <field name="password" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                        </group>
                        <group>
                            <field name="date_granted" />
                            <field name="prod_status" />
                            <field name="comment" />
                        </group>
                    </group>
                    <!-- Client Test -->
                    <group col='2' invisible="not test_env">
                        <group>
                            <field name="name" />
                            <field name="server" widget="url" />
                            <field name="odoo_version" />
                        </group>
                        <group>
                            <field name="master_password" />
                            <field name="status" />
                        </group>
                    </group>
                    <notebook invisible="erpsoftapp_prod or test_env">
                        <page name="DBs" string="Databases">
                            <field name="db_ids" invisible="erpsoftapp_env or demo">
                                <list editable='bottom'>
                                    <field name="demo" column_invisible="1" />
                                    <field name="erpsoftapp_env" column_invisible="1" />
                                    <field name="is_helpdesk_user" column_invisible="1" />
                                    <field name="name" readonly="is_helpdesk_user" />
                                    <field name="password_policy" column_invisible="parent.erpsoftapp_env or parent.demo" readonly="is_helpdesk_user" />
                                    <field name="user_deactivation" column_invisible="parent.erpsoftapp_env or parent.demo" readonly="is_helpdesk_user" />
                                    <field name="url" widget="url" />
                                    <field name="username" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="password" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="server_status" readonly="is_helpdesk_user" />
                                    <field name="responsible_team" column_invisible="parent.erpsoftapp_env or parent.demo" readonly="is_helpdesk_user" required="not erpsoftapp_env or not demo"/>
                                    <field name="comment" readonly="is_helpdesk_user" />
                                </list>
                            </field>
                            <field name="demo_db_ids" invisible="not demo">
                                <list editable='bottom'>
                                    <field name="demo" column_invisible="1" />
                                    <field name="erpsoftapp_env" column_invisible="1" />
                                    <field name="is_helpdesk_user" column_invisible="1" />
                                    <field name="name" readonly="is_helpdesk_user" />
                                    <field name="username" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="password" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="url" widget="url" />
                                    <field name="server_status" string="Database Status" readonly="is_helpdesk_user" />
                                </list>
                            </field>
                            <field name="erp_db_ids" invisible="not erpsoftapp_env">
                                <list editable='bottom'>
                                    <field name="demo" column_invisible="1" />
                                    <field name="erpsoftapp_env" column_invisible="1" />
                                    <field name="is_helpdesk_user" column_invisible="1" />
                                    <field name="name" readonly="is_helpdesk_user" />
                                    <field name="url" widget="url" />
                                    <field name="username" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="password" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                                    <field name="comment" readonly="is_helpdesk_user" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="view_dbs_simple_form" model="ir.ui.view">
        <field name="name">db.line.simplified.form</field>
        <field name="model">db.line</field>
        <field name="arch" type="xml">
            <form string="All Databases">
                <sheet>
                    <field name="demo" invisible="1" />
                    <field name="erpsoftapp_env" invisible="1" />
                    <field name="is_helpdesk_user" invisible="1" />
                    <group>
                        <group>
                            <field name="name" readonly="is_helpdesk_user" />
                            <field name="url" widget="url" />
                            <field name="username" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                            <field name="password" groups="helpdesk_erp.group_technical_helpdesks,prod_access_control.group_production_helpdesk" />
                        </group>
                        <group>
                            <field name="password_policy" invisible="erpsoftapp_env or demo" readonly="is_helpdesk_user" />
                            <field name="user_deactivation" invisible="erpsoftapp_env or demo" readonly="is_helpdesk_user" />
                            <field name="server_status" readonly="is_helpdesk_user" />
                            <field name="responsible_team" invisible="erpsoftapp_env or demo" readonly="is_helpdesk_user" required="not erpsoftapp_env or not demo" />
                            <field name="comment" readonly="is_helpdesk_user" invisible="erpsoftapp_env or demo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

