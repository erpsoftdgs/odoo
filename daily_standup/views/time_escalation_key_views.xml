<odoo>
    <!-- List View for Time Escalation Key -->
        <record id="view_time_escalation_key_tree" model="ir.ui.view">
            <field name="name">time.escalation.key.list</field>
            <field name="model">time.escalation.key</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" string="Name" />
                    <field name="score" string="Score" />
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>
        <!-- Form View for Time Escalation Key -->
        <record id="view_time_escalation_key_form" model="ir.ui.view">
            <field name="name">time.escalation.key.form</field>
            <field name="model">time.escalation.key</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" string="Name" />
                            <field name="score" string="Score" />
                            <field name="color" widget="color_picker" string="Color" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Action for Time Escalation Key -->
        <record id="action_time_escalation_key" model="ir.actions.act_window">
            <field name="name">Time Escalation Key</field>
            <field name="res_model">time.escalation.key</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_time_escalation_key_tree" />
        </record>
</odoo>
