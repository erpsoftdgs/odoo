<odoo>
    <!-- List View for Escalation Key -->
    <record id="view_escalation_key_tree" model="ir.ui.view">
        <field name="name">escalation.key.list</field>
        <field name="model">escalation.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name" />
                <field name="score" string="Score" />
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <!-- Form View for Escalation Key -->
    <record id="view_escalation_key_form" model="ir.ui.view">
        <field name="name">escalation.key.form</field>
        <field name="model">escalation.key</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Name" />
                        <field name="score" string="Score" />
                        <field name="color" widget="color_picker" string="Color" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action for Escalation Key -->
    <record id="action_escalation_key" model="ir.actions.act_window">
        <field name="name">Escalation Key</field>
        <field name="res_model">escalation.key</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_escalation_key_tree" />
    </record>
</odoo>
