<odoo>
    <!-- List View (KPI Dashboard) -->
    <record model="ir.ui.view" id="view_performance_tree">
        <field name="name">performance.list</field>
        <field name="model">performance</field>
        <field name="arch" type="xml">
            <list string="Performance KPI" create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="completed_date"/>
                <field name="priority_score"/>
                <field name="time_estimation_score"/>
                <field name="escalation_score"/>
                <field name="total_score"/>
            </list>
        </field>
    </record>

    <record id="view_performance_tree_search" model="ir.ui.view">
        <field name="name">performance.list.search</field>
        <field name="model">performance</field>
        <field name="arch" type="xml">
            <search string="Daily Standup Analysis">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="completed_date"/>
                <field name="creation_date"/>
                <field name="approved_date"/>

                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by':'employee_id'}"/>
                    <filter string="Department" name="group_department_id"
                            context="{'group_by':'department_id'}"/>
                    <filter string="Completed Date" name="group_completed_date"
                            context="{'group_by':'completed_date'}"/>
                    <filter string="Creation Date" name="group_creation_date"
                            context="{'group_by':'creation_date'}"/>
                    <filter string="Approved Date" name="group_approved_date"
                            context="{'group_by':'approved_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View (read-only details) -->
    <record id="view_performance_form" model="ir.ui.view">
        <field name="name">performance.form</field>
        <field name="model">performance</field>
        <field name="arch" type="xml">
            <form string="Performance" create="false" edit="false" delete="false">
                <group>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="completed_date"/>
                    <field name="creation_date"/>
                    <field name="approved_date"/>
                </group>
                <group>
                    <field name="priority_score"/>
                    <field name="time_estimation_score"/>
                    <field name="escalation_score"/>
                    <field name="total_score"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_performance" model="ir.actions.act_window">
        <field name="name">KPI Performance</field>
        <field name="res_model">performance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_performance_tree"/>
        <field name="context">{}</field>
    </record>

</odoo>