<odoo>
    <record id="view_daily_standup_analysis_tree" model="ir.ui.view">
        <field name="name">daily.standup.analysis.list</field>
        <field name="model">daily.standup.analysis</field>
        <field name="arch" type="xml">
            <list string="Daily Standup Analysis">
                <field name="employee_name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="completion_date"/>
                <field name="priority_task_key_id"/>
                <field name="percentage_completion"/>
            </list>
        </field>
    </record>
    <record id="view_daily_standup_analysis_graph" model="ir.ui.view">
        <field name="name">daily.standup.analysis.graph</field>
        <field name="model">daily.standup.analysis</field>
        <field name="arch" type="xml">
            <!-- <graph string="Daily Standup Analysis">
                <field name="employee_name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="completion_date" interval="day"/>
                <field name="priority_task_key_id"/>
                <field name="percentage_completion" type="measure"/>
            </graph> -->
            <graph string="Daily Standup Analysis" type="bar">
                <!-- Group By Dimensions -->
                <!-- <field name="employee_name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="completion_date" interval="day"/>
                <field name="priority_task_key_id"/> -->
                
                <!-- Measure -->
                <field name="percentage_completion" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_daily_standup_analysis" model="ir.actions.act_window">
        <field name="name">Daily Standup Analysis</field>
        <field name="res_model">daily.standup.analysis</field>
        <field name="view_mode">graph,list</field>
    </record>
    <record id="view_daily_standup_analysis_search" model="ir.ui.view">
        <field name="name">daily.standup.analysis.search</field>
        <field name="model">daily.standup.analysis</field>
        <field name="arch" type="xml">
            <search string="Daily Standup Analysis">
                <field name="employee_name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="completion_date"/>
                <field name="priority_task_key_id"/>
                <field name="percentage_completion"/>

                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by':'employee_name'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by':'project_id'}"/>
                    <filter string="Task" name="group_task"
                            context="{'group_by':'task_id'}"/>
                    <filter string="Completion Date" name="group_completion_date"
                            context="{'group_by':'completion_date'}"/>
                    <filter string="Key Priority Task" name="group_priority_task"
                            context="{'group_by':'priority_task_key_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
