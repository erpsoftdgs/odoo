<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_csm_meeting">
        <field name="name">CSM</field>
        <field name="description">CSM Meeting Role</field>
        <field name="sequence">1</field>
    </record>
    <record id="csm_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_csm_meeting"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name"> CX Manager</field>
        <field name="category_id" ref="module_category_csm_meeting"/>
         <field name="implied_ids" eval="[(4, ref('csm_group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
        <record id="group_team_lead" model="res.groups">
            <field name="name">Team Lead</field>
            <field name="category_id" ref="module_category_csm_meeting"/>
        </record>

        <record id="account_manager" model="res.groups">
            <field name="name">Account Manager</field>
            <field name="category_id" ref="module_category_csm_meeting"/>
        </record>
     <record id="project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="category_id" ref="module_category_csm_meeting"/>
        </record>


</odoo>