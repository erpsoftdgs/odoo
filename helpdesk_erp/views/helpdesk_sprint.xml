<odoo>

<data>
 <record model="ir.sequence" id="helpdesk_sprint_sequence">
        <field name="name">HelpDesk Sprint</field>
        <field name="code">helpdesk.sprint</field>
        <field name="prefix">HDS</field>
        <field name="padding">5</field>
    </record>


      <record id="helpdesk_sprint_form" model="ir.ui.view">
            <field name="name">helpdesk.sprint.form</field>
            <field name="model">helpdesk.sprint</field>
            <field name="arch" type="xml">
                <form string="Heldesk Sprint">
                     <header>
<!--            TODO remove stock.group_stock_manager from Confirm-->

            <button groups="helpdesk_erp.group_helpdesk_product_owner" name="submit_sprint_log" string="Submit" type="object" invisible="state != 'draft'" class="btn-primary"/>
                <button groups="helpdesk_erp.group_technical_helpdesks" name="approve_sprint_log" string="Approve" type="object" invisible="state != 'submit'" class="btn-primary"/><field name="state" widget="statusbar" statusbar_visible="draft,submit,confirm,cancelled"/>
          <button groups="helpdesk_erp.group_technical_helpdesks" name="cancel_sprint_log" string="Cancel" type="object" invisible="state not in ['draft', 'submit', 'confirm']"/>
          <button groups="" name="draft_sprint_log" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>

          </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                <button name="open_sprint_items" type="object" class="oe_stat_button" icon="fa-ticket" >
                            <field name="ticket_count" widget="statinfo" string="Tickets"/>
                        </button>

                    </div>
                    <h3>
                        <field name="name"  readonly="1"/>
                    </h3>
                    <group>
                        <group>
			             <field name="objectives"/>


                        </group>
                        <group>
                            <field name="sprint_start_date" readonly="state == 'confirm'"/>
                         <field name="sprint_end_date" readonly="state == 'confirm'"/>


                        </group>
                    </group>
                     <field name="scrum_meeting_note" placeholder="Scrum Meeting Notes..."/>

                </sheet>
                <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>


    <record id="view_helpdesk_sprint_filter" model="ir.ui.view">
            <field name="name">helpdesk.sprint.select</field>
            <field name="model">helpdesk.sprint</field>
            <field name="arch" type="xml">
                <search string="Search HelpDesk Sprint">
                    <field name="name"  string="Tickets"/>


                </search>
            </field>
        </record>


      <record id="helpdesk_sprint_tree_view" model="ir.ui.view">
            <field name="name">helpdesk.sprint.tree</field>
            <field name="model">helpdesk.sprint</field>
            <field name="arch" type="xml">
                <list string="Helpdesk Sprint">

		                <field name="name"/>
		                <field name="sprint_start_date"/>
                         <field name="sprint_end_date"/>
                         <field name="state"/>

                </list>
            </field>
        </record>


     <record model="ir.actions.act_window" id="action_helpdesk_sprint_windows">
          <field name="name">Helpdesk Sprint</field>
         <field name="res_model">helpdesk.sprint</field>
         
         <field name="view_mode">list,form</field>
         <field name="context">{}</field>
    <field name="view_id" ref="helpdesk_sprint_tree_view" />
    </record>

 



      <menuitem id="menu_helpdesk_sprint" name="Sprint Log"  sequence="20" parent="helpdesk.helpdesk_ticket_menu_main"
                groups="helpdesk_erp.group_developer_helpdesks,helpdesk_erp.group_helpdesk_product_owner,helpdesk_erp.group_technical_helpdesks,helpdesk_erp.group_release_manager_helpdesks,helpdesk_erp.group_pm_helpdesks" action="action_helpdesk_sprint_windows"/>














   </data>


</odoo>
