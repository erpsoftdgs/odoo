<odoo>
    <record id="view_sales_analyst_wizard" model="ir.ui.view">
        <field name="name">sales.analyst.wizard.form</field>
        <field name="model">sales.analyst.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button string="OK" class="btn-primary" name="action_confirm_sales_analyst" type="object"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>