<odoo>
    <!-- List View for Employee Tags -->
    <record id="view_employee_tags_tree" model="ir.ui.view">
        <field name="name">employee.tags.list</field>
        <field name="model">employee.tags</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Name" />
                <!-- <field name="score" string="Score" /> -->
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <!-- Form View for Employee Tags -->
    <record id="view_employee_tags_form" model="ir.ui.view">
        <field name="name">employee.tags.form</field>
        <field name="model">employee.tags</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Name" />
                        <field name="color" widget="color_picker" string="Color" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action for Employee Tags -->
    <record id="action_employee_tags" model="ir.actions.act_window">
        <field name="name">Employee Tags</field>
        <field name="res_model">employee.tags</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_employee_tags_tree" />
    </record>
</odoo>
