    <record id="client_environment_access_tree" model="ir.ui.view">
  <field name="name">client.environment.access.tree</field>
  <field name="model">client.environment.access</field>
  <field name="arch" type="xml">
    <list>
      <!-- always hidden -->
      <field name="demo" column_invisible="True"/>
      <field name="erpsoftapp_env" column_invisible="True"/>

      <!-- hide if any of these flags is set -->
      <field name="server_id"
             column_invisible="context.get('default_demo')
                               or context.get('default_erpsoftapp_env')
                               or context.get('default_erpsoftapp_prod')
                               or context.get('default_test_env')"/>

      <!-- hide on env/prod menus -->
      <field name="name"
             column_invisible="context.get('default_erpsoftapp_env')
                               or context.get('default_erpsoftapp_prod')"/>

      <!-- show only when demo OR env OR prod menu is used -->
      <field name="odoo_version"
             column_invisible="not (context.get('default_demo')
                                    or context.get('default_erpsoftapp_env')
                                    or context.get('default_erpsoftapp_prod'))"/>

      <field name="server"/>

      <!-- show only on prod menu -->
      <field name="date_granted"
             column_invisible="not context.get('default_erpsoftapp_prod')"/>

      <!-- hide on demo menu -->
      <field name="status"
             column_invisible="context.get('default_demo')"/>
    </list>
  </field>
</record>


    <record id="action_client_env_systems" model="ir.actions.act_window">
        <field name="name">Client Environment</field>
        <field name="type">ir.actions.act_window</field>
